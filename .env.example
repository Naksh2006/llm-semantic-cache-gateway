# ═══════════════════════════════════════════════════════════════════
# LLM Semantic Cache Gateway — Environment Configuration
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ── Gateway Authentication ───────────────────────────────────────
# If set, every request must include: Authorization: Bearer <key>
# Leave empty for local development (auth is disabled).
# ALWAYS set this before deploying publicly!
# GATEWAY_API_KEY=sk-your-secret-key-here

# ── Rate Limiting ────────────────────────────────────────────────
# Per-IP request ceiling (uses "limits" library syntax).
# Examples: "30/minute", "5/second", "100/hour", "5/second;100/hour"
# Default: 30/minute.  Set to empty string to disable.
# RATE_LIMIT=30/minute

# ── Qdrant (single persistence layer) ────────────────────────────
# Local Docker (default):
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=llm_cache
# Qdrant Cloud — uncomment and fill in your cluster details:
# QDRANT_URL=https://your-cluster-id.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-cloud-api-key

# ── Local Embedding Model ────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ── LLM Provider (BYOK — set ONE of the keys below) ─────────────
# The gateway auto-detects the provider from whichever key is set.
# Priority: GEMINI_API_KEY → OPENAI_API_KEY → ANTHROPIC_API_KEY
# Set LLM_PROVIDER to override auto-detection (e.g. "gemini").
#
# LLM_PROVIDER=               # Optional: "gemini", "openai", or "anthropic"
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Legacy (backward-compatible, prefer BYOK keys above) ────────
# LLM_MODEL=gemini/gemini-2.5-flash
# LLM_API_KEY=

# ── Cache Behaviour ──────────────────────────────────────────────
DEFAULT_SIMILARITY_THRESHOLD=0.92
MIN_SIMILARITY_THRESHOLD=0.70
MAX_SIMILARITY_THRESHOLD=0.999
CACHE_TTL_SECONDS=3600
LFU_SPIKE_THRESHOLD=10
LFU_SPIKE_TTL_EXTENSION=7200
