# ═══════════════════════════════════════════════════════════════════
# LLM Semantic Cache Gateway — Environment Configuration
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ── Qdrant (single persistence layer) ────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=llm_cache

# ── Local Embedding Model ────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ── LLM Provider (BYOK — set ONE of the keys below) ─────────────
# The gateway auto-detects the provider from whichever key is set.
# Priority: GEMINI_API_KEY → OPENAI_API_KEY → ANTHROPIC_API_KEY
# Set LLM_PROVIDER to override auto-detection (e.g. "gemini").
#
# LLM_PROVIDER=               # Optional: "gemini", "openai", or "anthropic"
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Legacy (backward-compatible, prefer BYOK keys above) ────────
# LLM_MODEL=gemini/gemini-2.5-flash
# LLM_API_KEY=

# ── Cache Behaviour ──────────────────────────────────────────────
DEFAULT_SIMILARITY_THRESHOLD=0.92
MIN_SIMILARITY_THRESHOLD=0.70
MAX_SIMILARITY_THRESHOLD=0.999
CACHE_TTL_SECONDS=3600
LFU_SPIKE_THRESHOLD=10
LFU_SPIKE_TTL_EXTENSION=7200
